              "highCutHz": { "type": "number", "default": 20000, "minimum": 1200, "maximum": 20000, "portableParameter": true },
              "diffusionLowCutHz": { "type": "number", "default": 20, "minimum": 20, "maximum": 1200 },
              "diffusionHighCutHz": { "type": "number", "default": 20000, "minimum": 1200, "maximum": 20000 },
              "stereoWidth": { "type": "number", "default": 1, "minimum": 0, "maximum": 2, "portableParameter": true }
            }}
          }
        },
        "spectral": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "schemaVersion", "stateBytes", "tombstone", "state"],
          "properties": {
            "id": { "const": 15 }, "schemaVersion": { "const": 1 }, "stateBytes": { "const": 60 }, "tombstone": { "const": false },
            "state": { "type": "object", "additionalProperties": false, "required": ["enabled", "fftSize", "overlap", "mode", "freeze", "gateThresholdDb", "gateAttackMs", "gateReleaseMs", "morph", "binShift", "blur", "harmonicPercussiveBalance", "noiseReduction", "profileLearn", "mix"], "properties": {
