              "reflections": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
              "reflectionSpin": { "type": "boolean" }, "reflectionModAmountMs": { "type": "number", "default": 17.5, "minimum": 0, "maximum": 25 },
              "reflectionModRateHz": { "type": "number", "default": 0.3, "minimum": 0.01, "maximum": 5 },
              "reflectionShape": { "type": "number", "default": 0.5, "minimum": 0, "maximum": 1 },
              "diffuse": { "type": "number", "default": 1, "minimum": 0, "maximum": 1 },
              "size": { "type": "number", "default": 0.65, "minimum": 0, "maximum": 1 },
