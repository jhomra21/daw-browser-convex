          "properties": {
            "id": { "const": 14 }, "schemaVersion": { "const": 1 }, "stateBytes": { "const": 72 }, "tombstone": { "const": false },
            "state": { "type": "object", "additionalProperties": false, "required": ["enabled", "wet", "decaySec", "preDelayMs", "reflections", "reflectionSpin", "reflectionModAmountMs", "reflectionModRateHz", "reflectionShape", "diffuse", "size", "diffusion", "density", "lowCutHz", "highCutHz", "diffusionLowCutHz", "diffusionHighCutHz", "stereoWidth"], "properties": {
              "enabled": { "type": "boolean" }, "wet": { "type": "number", "default": 0.25, "minimum": 0, "maximum": 1, "portableParameter": true },
              "decaySec": { "type": "number", "default": 2.2, "minimum": 0.05, "maximum": 12 },
