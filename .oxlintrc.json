{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "jsPlugins": [
    "eslint-plugin-solid",
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "dist/**",
    "node_modules/**",
    "src/routeTree.gen.ts",
    "convex/_generated/**",
    "api/worker-configuration.d.ts",
    "tools/oxlint/anti-slop/**"
  ],
  "options": {
    "reportUnusedDisableDirectives": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/types/file-system-access.d.ts",
        "src/types/user-agent-data.d.ts",
        "src/main.tsx"
      ],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": [
        "src/lib/desktop/capability-export-output-targets.ts"
      ],
      "rules": {
        "eslint/no-restricted-properties": [
          "error",
          {
            "property": "createWritable",
            "message": "Desktop export output goes through the scoped capability bridge, not a renderer file handle."
          }
        ]
      }
    },
    {
      "files": [
        "src/components/Timeline.tsx"
      ],
      "rules": {
        "eslint/no-use-before-define": "error"
      }
    },
    {
      "files": [
        "packages/**"
      ],
      "excludeFiles": [
        "**/*.test.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~",
                  "~/**",
                  "../../src/**",
                  "../../apps/**",
                  "../../convex/**",
                  "../../api/**",
                  "../../tools/**",
                  "../../../src/**",
                  "../../../apps/**",
                  "../../../convex/**",
                  "../../../api/**",
                  "../../../tools/**",
                  "../../../../src/**",
                  "../../../../apps/**",
                  "../../../../convex/**",
                  "../../../../api/**",
                  "../../../../tools/**",
                  "../../../../../src/**",
                  "../../../../../apps/**",
                  "../../../../../convex/**",
                  "../../../../../api/**",
                  "../../../../../tools/**"
                ],
                "message": "packages are the lowest layer: they must not import src, apps, convex or api."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "convex/**",
        "api/**"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "convex/_generated/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~",
                  "~/**",
                  "../src/**",
                  "../apps/**",
                  "../../src/**",
                  "../../apps/**",
                  "../../../src/**",
                  "../../../apps/**"
                ],
                "message": "convex and api may import packages only, not src or apps."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/desktop/**"
      ],
      "excludeFiles": [
        "**/*.test.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~",
                  "~/**",
                  "../src/**",
                  "../tools/**",
                  "../../src/**",
                  "../../tools/**",
                  "../../../src/**",
                  "../../../tools/**"
                ],
                "message": "apps/desktop may import packages only; shared renderer/main code belongs in packages/*."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/**"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.browser-test.ts",
        "**/*.browser-test.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~/components",
                  "~/components/**",
                  "~/hooks",
                  "~/hooks/**",
                  "~/context",
                  "~/context/**",
                  "~/routes",
                  "~/routes/**",
                  "../components/**",
                  "../hooks/**",
                  "../context/**",
                  "../routes/**",
                  "../../components/**",
                  "../../hooks/**",
                  "../../context/**",
                  "../../routes/**",
                  "../../../components/**",
                  "../../../hooks/**",
                  "../../../context/**",
                  "../../../routes/**",
                  "../../../../components/**",
                  "../../../../hooks/**",
                  "../../../../context/**",
                  "../../../../routes/**"
                ],
                "message": "src/lib is below hooks, context, components and routes: move the shared type or model down into src/lib."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/**"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.browser-test.ts",
        "**/*.browser-test.tsx",
        "src/lib/desktop/**",
        "src/lib/export/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~/components",
                  "~/components/**",
                  "~/hooks",
                  "~/hooks/**",
                  "~/context",
                  "~/context/**",
                  "~/routes",
                  "~/routes/**",
                  "../components/**",
                  "../hooks/**",
                  "../context/**",
                  "../routes/**",
                  "../../components/**",
                  "../../hooks/**",
                  "../../context/**",
                  "../../routes/**",
                  "../../../components/**",
                  "../../../hooks/**",
                  "../../../context/**",
                  "../../../routes/**",
                  "../../../../components/**",
                  "../../../../hooks/**",
                  "../../../../context/**",
                  "../../../../routes/**",
                  "~/lib/desktop",
                  "~/lib/desktop/**",
                  "./desktop/**",
                  "../desktop/**",
                  "../../desktop/**"
                ],
                "message": "Browser-side src/lib modules must not import src/lib/desktop, which is desktop-only; only the desktop composition path (src/lib/desktop, src/lib/export) may."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/hooks/**",
        "src/context/**"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.browser-test.ts",
        "**/*.browser-test.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~/components",
                  "~/components/**",
                  "~/routes",
                  "~/routes/**",
                  "../components/**",
                  "../routes/**",
                  "../../components/**",
                  "../../routes/**",
                  "../../../components/**",
                  "../../../routes/**",
                  "../../../../components/**",
                  "../../../../routes/**"
                ],
                "message": "hooks and context are below components and routes: move the shared type or model down into src/lib or src/hooks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/**"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.browser-test.ts",
        "**/*.browser-test.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "~/routes",
                  "~/routes/**",
                  "../routes/**",
                  "../../routes/**",
                  "../../../routes/**",
                  "../../../../routes/**"
                ],
                "message": "components are below routes."
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "eslint/no-debugger": "error",
    "eslint/no-unsafe-finally": "warn",
    "import/no-self-import": "error",
    "eslint/eqeqeq": [
      "warn",
      "smart"
    ],
    "eslint/prefer-const": "warn",
    "typescript/consistent-type-definitions": [
      "warn",
      "type"
    ],
    "typescript/consistent-type-imports": "warn",
    "typescript/no-import-type-side-effects": "warn",
    "typescript/prefer-as-const": "warn",
    "import/no-duplicates": "warn",
    "import/no-cycle": "warn",
    "unicorn/no-abusive-eslint-disable": "warn",
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-undef": [
      "error",
      {
        "typescriptEnabled": true
      }
    ],
    "solid/jsx-uses-vars": "error",
    "solid/no-innerhtml": "error",
    "solid/jsx-no-script-url": "error",
    "solid/no-destructure": "warn",
    "solid/prefer-for": "warn",
    "solid/reactivity": "warn",
    "solid/components-return-once": "warn",
    "solid/event-handlers": "warn",
    "solid/imports": "warn",
    "solid/style-prop": "warn",
    "solid/no-react-deps": "warn",
    "solid/no-react-specific-props": "warn",
    "solid/self-closing-comp": "warn",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": [
      "error",
      {
        "allowInTypeGuards": true
      }
    ],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  }
}
