{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["./worker-configuration.d.ts"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "../packages/shared/src/**/*.ts",
    "../packages/timeline-core/src/**/*.ts",
    "../src/types/**/*.ts"
  ],
  "exclude": [
    "../packages/**/*.test.ts",
    "**/*.test.ts"
  ]
}
