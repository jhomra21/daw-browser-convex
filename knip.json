{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/components/timeline/ClipComponent.browser-test.ts",
        "src/components/timeline/TimelineRuler.browser-test.ts",
        "tools/performance/30-track/generate-fixture.ts",
        "tools/performance/30-track/generator-runtime.ts",
        "tools/performance/30-track/run.ts",
        "tools/performance/30-track/run-runtime.ts",
        "tools/performance/30-track/v3-generate-fixture.ts",
        "tools/performance/30-track/v3-generator-runtime.ts",
        "tools/performance/30-track/v3-import-acceptance.ts",
        "tools/oxlint/anti-slop/rules/*.rule-test.ts"
      ]
    },
    "apps/desktop": {
      "entry": [
        "main.ts",
        "preload.ts",
        "portable-wasm-worklet-electron.cjs",
        "portable-wasm-worklet-fixture.mjs",
        "scripts/run-forge.ts"
      ]
    }
  },
  "ignoreFiles": [
    "public/audio-worklets/*.js",
    "public/audio-workers/daw-portable-capability-metadata-v1.d.ts",
    "public/audio-worklets/daw-portable-graph-envelope-v3.d.ts",
    "src/components/nav-user.tsx",
    "src/components/ui/avatar.tsx",
    "src/components/ui/badge.tsx",
    "src/components/ui/separator.tsx",
    "src/components/ui/sheet.tsx",
    "src/components/ui/sidebar.tsx",
    "src/components/ui/skeleton.tsx",
    "apps/desktop/no-pwa.ts",
    "apps/desktop/vite.main.config.ts",
    "apps/desktop/vite.preload.config.ts"
  ],
  "ignoreDependencies": [
    "@electron-forge/maker-dmg",
    "@electron-forge/maker-squirrel",
    "@electron-forge/maker-zip",
    "@electron-forge/plugin-fuses",
    "@electron-forge/plugin-vite"
  ],
  "ignoreBinaries": [
    "ps",
    "rev-parse",
    "status"
  ],
  "ignoreIssues": {
    "src/lib/local-cloud-id-map.ts": [
      "files",
      "exports",
      "types"
    ],
    "packages/audio-engine/src/effects/dsp.ts": [
      "exports"
    ],
    "src/lib/local-assets.ts": [
      "exports"
    ],
    "src/lib/local-ids.ts": [
      "exports",
      "types"
    ],
    "src/lib/local-project-db.ts": [
      "exports",
      "types"
    ],
    "src/lib/external-plugins.ts": [
      "exports"
    ],
    "src/lib/session.ts": [
      "exports"
    ],
    "src/lib/timeline-storage.ts": [
      "exports"
    ],
    "packages/audio-engine/src/audio-engine.ts": [
      "types"
    ],
    "packages/audio-engine/src/audio-stretch-cache.ts": [
      "exports"
    ],
    "packages/control-cli/src/mcp.ts": [
      "files"
    ],
    "packages/audio-engine/src/clip-scheduler.ts": [
      "exports"
    ],
    "src/lib/timeline-repository/types.ts": [
      "types"
    ],
    "api/control-oauth.ts": [
      "exports",
      "types"
    ],
    "apps/desktop/plugin-catalog.ts": [
      "files",
      "exports"
    ],
    "src/components/ui/**/*.tsx": [
      "exports",
      "types"
    ]
  },
  "tags": [
    "-lintignore"
  ]
}
