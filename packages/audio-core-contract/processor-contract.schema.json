              "noiseDb": { "type": "number", "default": -80, "minimum": -120, "maximum": -24, "portableParameter": true },
              "quantization": { "enum": ["round", "floor", "truncate"] },
              "dither": { "enum": ["off", "rectangular", "triangular"] },
              "mix": { "type": "number", "default": 1, "minimum": 0, "maximum": 1, "portableParameter": true },
              "seed": { "type": "number", "minimum": 1, "maximum": 4294967295 }
            }}
          }
        },
        "delay": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "schemaVersion", "stateBytes", "tombstone", "state"],
          "properties": {
            "id": { "const": 13 }, "schemaVersion": { "const": 1 }, "stateBytes": { "const": 32 }, "tombstone": { "const": false },
            "state": { "type": "object", "additionalProperties": false, "required": ["enabled", "delayMs", "feedback", "dryWet", "pingPong", "filterEnabled", "lowCutHz", "highCutHz"], "properties": {
              "enabled": { "type": "boolean" }, "delayMs": { "type": "number", "default": 250, "minimum": 1, "maximum": 3000, "portableParameter": true },
              "feedback": { "type": "number", "default": 0.25, "minimum": 0, "maximum": 0.95, "portableParameter": true },
              "dryWet": { "type": "number", "default": 0.2, "minimum": 0, "maximum": 1, "portableParameter": true },
              "pingPong": { "type": "boolean" }, "filterEnabled": { "type": "boolean" },
